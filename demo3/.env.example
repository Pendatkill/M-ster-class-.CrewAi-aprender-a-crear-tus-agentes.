# Copia este archivo como .env y rellena lo que necesites.

# Modelo que usan los agentes (formato proveedor/modelo)
# Por defecto: Ollama en local, gratis y sin API key (instala el modelo con: ollama pull qwen2.5:7b)
MODEL=ollama/qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Alternativa con Anthropic:
# MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# Alternativa con OpenAI:
# MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=

# 1 = simular agentes sin llamar a ningún LLM
DEMO_MODE=0
